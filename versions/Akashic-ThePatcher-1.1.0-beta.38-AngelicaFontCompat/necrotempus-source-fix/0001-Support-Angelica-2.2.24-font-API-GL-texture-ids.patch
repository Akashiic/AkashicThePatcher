+++ b/src/main/java/io/github/cruciblemc/necrotempus/modules/features/font/AngelicaFontCompat.java
@@ -0,0 +1,30 @@
+package io.github.cruciblemc.necrotempus.modules.features.font;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.texture.ITextureObject;
+import net.minecraft.util.ResourceLocation;
+
+public final class AngelicaFontCompat {
+
+    /**
+     * Returned for a glyph whose texture has not been uploaded yet. Angelica only treats 0 as "untextured", and the
+     * glyph draw commands that carry this value are taken over by {@code BatchingFontRendererMixin}, so it is never
+     * bound.
+     */
+    public static final int PENDING_TEXTURE = -1;
+
+    private AngelicaFontCompat() {}
+
+    /**
+     * Angelica 2.2.24+ identifies font textures by GL id instead of {@link ResourceLocation}. This only looks the
+     * texture up: NecroTempus binds (and so loads) it itself when it renders the glyph.
+     */
+    public static int textureId(ResourceLocation location) {
+        if (location == null) return 0;
+        final ITextureObject texture = Minecraft.getMinecraft()
+            .getTextureManager()
+            .getTexture(location);
+        final int id = texture != null ? texture.getGlTextureId() : 0;
+        return id > 0 ? id : PENDING_TEXTURE;
+    }
+}
