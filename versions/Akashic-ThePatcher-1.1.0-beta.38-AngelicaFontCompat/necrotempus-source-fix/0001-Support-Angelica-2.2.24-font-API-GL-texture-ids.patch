+++ b/src/main/java/io/github/cruciblemc/necrotempus/modules/mixin/AngelicaFontApiProbe.java
@@ -0,0 +1,51 @@
+package io.github.cruciblemc.necrotempus.modules.mixin;
+
+import java.io.IOException;
+import java.io.InputStream;
+
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassVisitor;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+
+/**
+ * Tells whether the installed Angelica has the font API {@code BatchingFontRendererMixin} is written against
+ * (Angelica 2.2.24+, where draw commands carry a GL texture id). Reads the class file only, so nothing is loaded
+ * before Mixin gets to transform it.
+ */
+public final class AngelicaFontApiProbe {
+
+    private static final String TARGET = "com/gtnewhorizons/angelica/client/font/BatchingFontRenderer.class";
+    private static final String PUSH_DRAW_CMD_DESC = "(IIIZ)V";
+
+    private static Boolean supported;
+
+    private AngelicaFontApiProbe() {}
+
+    public static synchronized boolean isSupported() {
+        if (supported == null) {
+            supported = probe();
+        }
+        return supported;
+    }
+
+    private static boolean probe() {
+        try (InputStream in = AngelicaFontApiProbe.class.getClassLoader()
+            .getResourceAsStream(TARGET)) {
+            if (in == null) return false;
+            final boolean[] found = { false };
+            new ClassReader(in).accept(new ClassVisitor(Opcodes.ASM5) {
+
+                @Override
+                public MethodVisitor visitMethod(int access, String name, String desc, String signature,
+                    String[] exceptions) {
+                    if ("pushDrawCmd".equals(name) && PUSH_DRAW_CMD_DESC.equals(desc)) found[0] = true;
+                    return null;
+                }
+            }, ClassReader.SKIP_CODE | ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+            return found[0];
+        } catch (IOException | RuntimeException e) {
+            return false;
+        }
+    }
+}
